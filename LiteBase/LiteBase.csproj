<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <Version>0.1.3</Version>
        <RootNamespace>LiteBase</RootNamespace>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
        <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
        <Authors>SmithTechStudios</Authors>
        <Description>Embeddable SQLite database explorer UI for ASP.NET Core applications.</Description>
        <PackageProjectUrl>https://github.com/SmithTechStudios/LiteBase</PackageProjectUrl>
        <RepositoryUrl>https://github.com/SmithTechStudios/LiteBase.git</RepositoryUrl>
        <RepositoryType>git</RepositoryType>
    </PropertyGroup>

    <ItemGroup>
        <Compile Include="*.cs"/>
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App"/>
        <PackageReference Include="Dapper" Version="2.1.35"/>
        <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.2.0"/>
        <PackageReference Include="Microsoft.Data.Sqlite.Core" Version="8.0.10"/>
        <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="8.0.10"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="ui/dist/index.css"/>
        <None Remove="ui/dist/index.html"/>
        <None Remove="ui/dist/index.js"/>
        <None Remove="index.html"/>
        <None Remove="ui/dist/litebase.css"/>
        <EmbeddedResource Include="ui/dist/litebase.css">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
        <None Remove="ui/dist/litebase.js"/>
        <EmbeddedResource Include="ui/dist/litebase.js">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </EmbeddedResource>
    </ItemGroup>


</Project>
